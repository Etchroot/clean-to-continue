* text=auto
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.shadergraph text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unity serialization intentionally emits trailing spaces for empty YAML values.
*.asset text eol=lf -whitespace
*.meta text eol=lf -whitespace
*.unity text eol=lf -whitespace
*.mat text eol=lf -whitespace
*.prefab text eol=lf -whitespace
*.renderTexture text eol=lf -whitespace
*.inputactions text eol=lf -whitespace

*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
